# Production-like local rehearsal environment.
# Real deployments should inject secrets from the platform secret manager.

DEVOPS_AGENT_APP_ENV=production
DEVOPS_AGENT_SERVICE_NAME=devops-agent-platform
DEVOPS_AGENT_DATABASE_URL=postgresql+psycopg://devops_agent:devops_agent@postgres:5432/devops_agent
DEVOPS_AGENT_LOG_LEVEL=INFO

DEVOPS_AGENT_ALERT_WEBHOOK_AUTH_ENABLED=true
DEVOPS_AGENT_ALERT_WEBHOOK_SECRET=replace-with-secret-manager-value-32-bytes
DEVOPS_AGENT_HTTP_RATE_LIMIT_ENABLED=true
DEVOPS_AGENT_HTTP_RATE_LIMIT_REQUESTS=300
DEVOPS_AGENT_HTTP_RATE_LIMIT_WINDOW_SECONDS=60
DEVOPS_AGENT_METRICS_ENABLED=true

DEVOPS_AGENT_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
DEVOPS_AGENT_KAFKA_TOPIC=devops-agent.events.v1
DEVOPS_AGENT_KAFKA_CLIENT_ID=devops-agent-platform
DEVOPS_AGENT_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

DEVOPS_AGENT_OUTBOX_WORKER_ENABLED=true
DEVOPS_AGENT_OUTBOX_WORKER_ID=outbox-worker-001

DEVOPS_AGENT_RCA_CONSUMER_ENABLED=false
DEVOPS_AGENT_RCA_CONSUMER_GROUP_ID=devops-agent-rca-v1
DEVOPS_AGENT_RCA_DEAD_LETTER_TOPIC=devops-agent.rca.dead-letter.v1
DEVOPS_AGENT_PROMETHEUS_BASE_URL=http://prometheus:9090
DEVOPS_AGENT_LOKI_BASE_URL=http://loki:3100
DEVOPS_AGENT_TEMPO_BASE_URL=http://tempo:3200

DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_ENABLED=false
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_GROUP_ID=devops-agent-ticket-submission-v1
DEVOPS_AGENT_TICKET_SUBMISSION_DEAD_LETTER_TOPIC=devops-agent.ticket-submission.dead-letter.v1
DEVOPS_AGENT_TICKETING_HTTP_JSON_ENABLED=false
DEVOPS_AGENT_TICKETING_HTTP_JSON_ENDPOINT_URL=https://ticketing.example.com/api/tickets

DEVOPS_AGENT_LLM_REPORT_ENABLED=false
DEVOPS_AGENT_LLM_PROVIDER_ORDER=openai,dashscope
DEVOPS_AGENT_LLM_OPENAI_API_STYLE=responses
DEVOPS_AGENT_LLM_OPENAI_MODEL=replace-with-approved-openai-model
DEVOPS_AGENT_LLM_DASHSCOPE_API_STYLE=chat_completions
DEVOPS_AGENT_LLM_DASHSCOPE_MODEL=qwen3.7-plus

DEVOPS_AGENT_ADMIN_OIDC_ENABLED=false
DEVOPS_AGENT_ADMIN_OIDC_ISSUER=https://identity.example.com/
DEVOPS_AGENT_ADMIN_OIDC_AUDIENCE=devops-agent-api
DEVOPS_AGENT_ADMIN_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
