# These values are intentionally local-only defaults. Override them when the
# stack is shared, and never reuse them outside this isolated E2E environment.
MINISHOP_E2E_ADMIN_TOKEN=minishop-e2e-admin-token-change-me-123456
MINISHOP_E2E_WEBHOOK_SECRET=minishop-e2e-webhook-secret-change-me-123456
MINISHOP_E2E_LLM_API_KEY=minishop-e2e-local-key
# To use the real DashScope provider, run Compose with the repository root
# .env as an explicit --env-file and set these values there.
MINISHOP_E2E_LLM_PROVIDER_ORDER=openai_compatible
MINISHOP_E2E_LLM_API_STYLE=chat_completions
MINISHOP_E2E_LLM_BASE_URL=http://llm-stub:8081
MINISHOP_E2E_LLM_MODEL=minishop-ground-truth-stub
