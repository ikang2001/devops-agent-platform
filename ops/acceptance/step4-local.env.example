# Disposable local Step 4 acceptance defaults.
# These are set automatically by run-step4-local.ps1 after docker compose starts.

DEVOPS_AGENT_TEST_POSTGRES_URL=postgresql+psycopg://devops_agent:devops_agent@localhost:15432/devops_agent
DEVOPS_AGENT_TEST_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
DEVOPS_AGENT_TEST_TENANT_ID=step4-local

DEVOPS_AGENT_TEST_PROMETHEUS_URL=http://localhost:18080
DEVOPS_AGENT_TEST_LOKI_URL=http://localhost:18080
DEVOPS_AGENT_TEST_TEMPO_URL=http://localhost:18080
DEVOPS_AGENT_TEST_OBSERVABILITY_TOKEN=

DEVOPS_AGENT_TEST_LLM_BASE_URL=http://localhost:18080
DEVOPS_AGENT_TEST_LLM_API_KEY=local-acceptance-key
DEVOPS_AGENT_TEST_LLM_MODEL=local-rca-model

DEVOPS_AGENT_TEST_TICKETING_ENDPOINT_URL=http://localhost:18080/api/tickets
DEVOPS_AGENT_TEST_TICKETING_TOKEN=

# OIDC is intentionally not mocked by the default local HTTP stack because the
# production authenticator requires HTTPS JWKS and a trusted certificate chain.
# Fill these from a real OIDC sandbox and pass -IncludeOidc to run all live tests.
DEVOPS_AGENT_TEST_OIDC_ISSUER=
DEVOPS_AGENT_TEST_OIDC_AUDIENCE=devops-agent
DEVOPS_AGENT_TEST_OIDC_JWKS_URL=
DEVOPS_AGENT_TEST_OIDC_TOKEN=
