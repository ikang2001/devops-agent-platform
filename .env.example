DEVOPS_AGENT_APP_ENV=local
DEVOPS_AGENT_SERVICE_NAME=devops-agent-platform
DEVOPS_AGENT_DATABASE_URL=postgresql+psycopg://devops:devops@localhost:5432/devops_agent
DEVOPS_AGENT_LOG_LEVEL=INFO
# 应用层限流是单进程防御；多副本生产环境仍需在可信网关配置全局限流。
DEVOPS_AGENT_HTTP_RATE_LIMIT_ENABLED=true
DEVOPS_AGENT_HTTP_RATE_LIMIT_REQUESTS=300
DEVOPS_AGENT_HTTP_RATE_LIMIT_WINDOW_SECONDS=60
DEVOPS_AGENT_HTTP_RATE_LIMIT_MAX_KEYS=10000
# 生产环境强制启用告警Webhook验签；密钥至少32字节且必须由密钥管理系统注入。
DEVOPS_AGENT_ALERT_WEBHOOK_AUTH_ENABLED=false
# DEVOPS_AGENT_ALERT_WEBHOOK_SECRET=inject-at-least-32-bytes-from-secret-manager
DEVOPS_AGENT_ALERT_WEBHOOK_TOLERANCE_SECONDS=300
DEVOPS_AGENT_ALERT_WEBHOOK_MAX_BODY_BYTES=65536
DEVOPS_AGENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DEVOPS_AGENT_KAFKA_TOPIC=devops-agent.events.v1
DEVOPS_AGENT_KAFKA_CLIENT_ID=devops-agent-platform
DEVOPS_AGENT_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# 使用SASL时必须把协议切到SASL_SSL或SASL_PLAINTEXT，并同时配置机制、用户名和密码。
# DEVOPS_AGENT_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# DEVOPS_AGENT_KAFKA_SASL_USERNAME=devops-agent
# DEVOPS_AGENT_KAFKA_SASL_PASSWORD=inject-from-secret-manager
DEVOPS_AGENT_OUTBOX_WORKER_ENABLED=false
# DEVOPS_AGENT_OUTBOX_WORKER_ID=outbox-worker-001
DEVOPS_AGENT_OUTBOX_BATCH_SIZE=20
DEVOPS_AGENT_OUTBOX_MAX_ATTEMPTS=5
DEVOPS_AGENT_OUTBOX_LEASE_SECONDS=120
DEVOPS_AGENT_OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
DEVOPS_AGENT_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=130
# RCA和工单提交Consumer读取同一个业务事件Topic，二者GROUP_ID和死信Topic必须保持不同。
# RCA Consumer 默认关闭；启用前必须配置三个租户隔离的观测数据源。
# 死信Topic必须独立于DEVOPS_AGENT_KAFKA_TOPIC，避免死信回流到业务事件流。
DEVOPS_AGENT_RCA_CONSUMER_ENABLED=false
DEVOPS_AGENT_RCA_CONSUMER_GROUP_ID=devops-agent-rca-v1
DEVOPS_AGENT_RCA_CONSUMER_CLIENT_ID=devops-agent-rca-consumer
DEVOPS_AGENT_RCA_DEAD_LETTER_TOPIC=devops-agent.rca.dead-letter.v1
DEVOPS_AGENT_RCA_CONSUMER_POLL_TIMEOUT_MS=1000
DEVOPS_AGENT_RCA_CONSUMER_LAG_TIMEOUT_MS=500
DEVOPS_AGENT_RCA_CONSUMER_MAX_LAG_PARTITIONS=1000
DEVOPS_AGENT_RCA_CONSUMER_LAG_SAMPLE_INTERVAL_SECONDS=5
DEVOPS_AGENT_RCA_CONSUMER_LEASE_SECONDS=120
DEVOPS_AGENT_RCA_CONSUMER_HEARTBEAT_SECONDS=30
DEVOPS_AGENT_RCA_CONSUMER_EXECUTION_TIMEOUT_SECONDS=1800
DEVOPS_AGENT_RCA_CONSUMER_SHUTDOWN_TIMEOUT_SECONDS=30
# 外部工单提交 Consumer 默认关闭；启用前必须注入或配置真实 TicketingGatewayPort。
# 死信Topic必须独立于DEVOPS_AGENT_KAFKA_TOPIC，避免重试和审计边界混在一起。
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_ENABLED=false
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_GROUP_ID=devops-agent-ticket-submission-v1
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_CLIENT_ID=devops-agent-ticket-submission-consumer
DEVOPS_AGENT_TICKET_SUBMISSION_DEAD_LETTER_TOPIC=devops-agent.ticket-submission.dead-letter.v1
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_POLL_TIMEOUT_MS=1000
DEVOPS_AGENT_TICKET_SUBMISSION_CONSUMER_SHUTDOWN_TIMEOUT_SECONDS=30
# HTTP JSON 工单网关默认关闭；启用后必须同时开启工单提交 Consumer。
DEVOPS_AGENT_TICKETING_HTTP_JSON_ENABLED=false
DEVOPS_AGENT_TICKETING_HTTP_JSON_ENDPOINT_URL=https://ticketing.example.com/api/tickets
# DEVOPS_AGENT_TICKETING_HTTP_JSON_BEARER_TOKEN=inject-from-secret-manager
DEVOPS_AGENT_TICKETING_HTTP_JSON_REQUEST_TIMEOUT_SECONDS=5
DEVOPS_AGENT_TICKETING_HTTP_JSON_MAX_RESPONSE_BYTES=262144
DEVOPS_AGENT_PROMETHEUS_BASE_URL=https://prometheus.example.com
# DEVOPS_AGENT_PROMETHEUS_BEARER_TOKEN=inject-from-secret-manager
DEVOPS_AGENT_LOKI_BASE_URL=https://loki.example.com
# DEVOPS_AGENT_LOKI_BEARER_TOKEN=inject-from-secret-manager
DEVOPS_AGENT_TEMPO_BASE_URL=https://tempo.example.com
# DEVOPS_AGENT_TEMPO_BEARER_TOKEN=inject-from-secret-manager
# LLM 报告默认关闭；API Key 必须由密钥管理系统注入，不能提交到仓库。
DEVOPS_AGENT_LLM_REPORT_ENABLED=false
DEVOPS_AGENT_LLM_REPORT_ENABLED=false
# Preferred failover order. Missing provider credentials are skipped.
DEVOPS_AGENT_LLM_PROVIDER_ORDER=openai,dashscope
# OpenAI is tried first by default.
DEVOPS_AGENT_LLM_OPENAI_API_STYLE=responses
DEVOPS_AGENT_LLM_OPENAI_MODEL=replace-with-approved-openai-model
# DEVOPS_AGENT_LLM_OPENAI_API_KEY=inject-from-secret-manager
# DashScope is the second provider by default.
DEVOPS_AGENT_LLM_DASHSCOPE_API_STYLE=chat_completions
DEVOPS_AGENT_LLM_DASHSCOPE_MODEL=qwen3.7-plus
# DEVOPS_AGENT_LLM_DASHSCOPE_API_KEY=inject-from-secret-manager
# Generic OpenAI-compatible/custom providers can be added to provider_order.
# DEVOPS_AGENT_LLM_OPENAI_COMPATIBLE_BASE_URL=https://model-gateway.example.com
# DEVOPS_AGENT_LLM_OPENAI_COMPATIBLE_MODEL=replace-with-approved-model
# DEVOPS_AGENT_LLM_OPENAI_COMPATIBLE_API_KEY=inject-from-secret-manager
# Legacy single-provider variables are still supported for compatibility:
# DEVOPS_AGENT_LLM_PROVIDER=openai_compatible
# DEVOPS_AGENT_LLM_API_STYLE=responses
# DEVOPS_AGENT_LLM_BASE_URL=https://model-gateway.example.com
# DEVOPS_AGENT_LLM_MODEL=replace-with-approved-model
# DEVOPS_AGENT_LLM_API_KEY=inject-from-secret-manager
DEVOPS_AGENT_LLM_REQUEST_TIMEOUT_SECONDS=30
DEVOPS_AGENT_LLM_MAX_RESPONSE_BYTES=262144
DEVOPS_AGENT_LLM_MAX_OUTPUT_TOKENS=2048
DEVOPS_AGENT_LLM_FAILURE_THRESHOLD=3
DEVOPS_AGENT_LLM_RECOVERY_TIMEOUT_SECONDS=60
# 审计清理默认关闭，确认合规留存期后再由部署环境显式开启。
DEVOPS_AGENT_AUDIT_RETENTION_WORKER_ENABLED=false
# DEVOPS_AGENT_AUDIT_RETENTION_WORKER_ID=audit-retention-worker-001
DEVOPS_AGENT_AUDIT_RETENTION_DAYS=30
DEVOPS_AGENT_AUDIT_RETENTION_BATCH_SIZE=100
DEVOPS_AGENT_AUDIT_RETENTION_ACTIVE_INTERVAL_SECONDS=1
DEVOPS_AGENT_AUDIT_RETENTION_IDLE_INTERVAL_SECONDS=3600
DEVOPS_AGENT_AUDIT_RETENTION_ERROR_BACKOFF_INITIAL_SECONDS=5
DEVOPS_AGENT_AUDIT_RETENTION_ERROR_BACKOFF_MAX_SECONDS=300
DEVOPS_AGENT_AUDIT_RETENTION_SHUTDOWN_TIMEOUT_SECONDS=30
DEVOPS_AGENT_READINESS_DATABASE_TIMEOUT_SECONDS=1
DEVOPS_AGENT_READINESS_CACHE_TTL_SECONDS=2
DEVOPS_AGENT_HTTP_ACCESS_LOG_HEALTH_ENDPOINTS=false
DEVOPS_AGENT_METRICS_ENABLED=true
DEVOPS_AGENT_METRICS_OUTBOX_QUERY_TIMEOUT_SECONDS=1
DEVOPS_AGENT_METRICS_OUTBOX_CACHE_TTL_SECONDS=5
DEVOPS_AGENT_ADMIN_OIDC_ENABLED=false
# MiniShop 本地演练专用固定管理员认证；生产环境禁止开启。
DEVOPS_AGENT_ADMIN_DEMO_ENABLED=false
DEVOPS_AGENT_ADMIN_DEMO_TOKEN=replace-with-at-least-32-ascii-characters
DEVOPS_AGENT_ADMIN_DEMO_TENANT_ID=demo-tenant
DEVOPS_AGENT_ADMIN_DEMO_ADMIN_ID=demo-admin
# 启用管理员OIDC后，以下三个值必须由部署环境显式提供。
DEVOPS_AGENT_ADMIN_OIDC_ISSUER=https://identity.example.com/
DEVOPS_AGENT_ADMIN_OIDC_AUDIENCE=devops-agent-api
DEVOPS_AGENT_ADMIN_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
DEVOPS_AGENT_ADMIN_OIDC_ALGORITHMS=RS256
DEVOPS_AGENT_ADMIN_OIDC_JWKS_CACHE_TTL_SECONDS=300
DEVOPS_AGENT_ADMIN_OIDC_UNKNOWN_KID_CACHE_SECONDS=30
DEVOPS_AGENT_ADMIN_OIDC_REQUEST_TIMEOUT_SECONDS=3
DEVOPS_AGENT_ADMIN_OIDC_LEEWAY_SECONDS=30
